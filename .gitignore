# SATyping — .gitignore
# Tailored to this pnpm monorepo: Vite/React frontend (artifacts/web),
# Express API (artifacts/api-server), Drizzle/Neon (lib/db), Vercel + Render deploys.

# ── Secrets — never commit ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build outputs ────────────────────────────────────────────────────────────
dist/
*.tsbuildinfo
.vercel
# Tauri (desktop app) — Rust build cache is multi-GB
src-tauri/target/
src-tauri/gen/

# ── Test & coverage ──────────────────────────────────────────────────────────
coverage/
*.lcov

# ── Logs & temp files ────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
tmp/

# ── Tooling state (local-only assistant/session files) ───────────────────────
.claude/settings.local.json
.hallmark/

# ── Editors & IDEs ───────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Release archives ─────────────────────────────────────────────────────────
*.zip
