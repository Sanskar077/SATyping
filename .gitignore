# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ── Environment secrets — never commit these ────────────────────────────────
.env
.env.local
.env.*.local
process/.env
!.env.example

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnpm-store/

# ── Build outputs (all workspace packages: artifacts/*, lib/*, scripts) ─────
dist/
**/dist/
build/
**/build/
out-tsc/
.next/
**/.next/
.turbo/
**/.turbo/
.vercel
tmp/
*.tsbuildinfo
.expo
.expo-shared

# ── Test / coverage ──────────────────────────────────────────────────────────
/coverage
**/coverage/
*.lcov
test-results/
playwright-report/

# ── Logs & temp files ────────────────────────────────────────────────────────
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
*.log
*.tmp
*.temp
*.bak
*.orig

# ── IDEs and editors ─────────────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Misc build caches ────────────────────────────────────────────────────────
/.sass-cache
/connect.lock
/libpeerconnection.log
/typings
.cache/
**/.cache/
.local/

# ── System files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Replit / platform artifacts (not part of the deployable app) ────────────
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
**/.replit-artifact/

# ── Packaging output (this project's own release zips) ──────────────────────
*.zip
