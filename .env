# =============================================================================
# SATyping — Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env (see .gitignore)
# =============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL — Neon, Supabase, Railway, or any Postgres provider)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_6Q0WzMinLuRZ@ep-winter-unit-aozoap0y-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ----------------------------------------------------------------------------
# API Server (artifacts/api-server)
# ----------------------------------------------------------------------------
# Port for the Express API server  (default: 3001 if not set)
PORT=3001

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=sanskarbajiraoalave

# Comma-separated list of allowed CORS origins.
# Leave unset to allow all origins (dev only). In production, set explicitly.
# Example: CORS_ORIGIN=https://your-app.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=

# ----------------------------------------------------------------------------
# Frontend (artifacts/gcc-tbc — Vite)
# ----------------------------------------------------------------------------
# Port the Vite dev server listens on (default: 5000)
# PORT=5000

# Base path where the frontend is served; use "/" for local and most hosts
BASE_PATH=/

# Public URL of the deployed API server — used at runtime by the React frontend.
# For local dev: http://localhost:3001
# For production: the public URL of your Render (or other) API service
VITE_API_BASE_URL=http://localhost:3001

