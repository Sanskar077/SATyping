##############################################################################
# SATyping — environment variables
#
# Copy this file to `.env` at the repo root (and/or per-package as needed)
# and fill in real values. Never commit the real `.env` file.
##############################################################################

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get this from your Neon project → Connection Details → "Pooled connection".
# Used by: lib/db (drizzle-kit push/migrate) and artifacts/api-server.
DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/dbname?sslmode=require

# ── API server (artifacts/api-server) ───────────────────────────────────────
NODE_ENV=development
PORT=4000
# Random long secret used to sign session cookies/tokens. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Comma-separated list of origins allowed to call the API (CORS).
# Local dev example: http://localhost:5173
# Production example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional: pino/console log verbosity (debug | info | warn | error)
LOG_LEVEL=info

# ── Frontend (artifacts/gcc-tbc) — must be prefixed VITE_ to be exposed ────
# Base URL of the deployed API server (Render), e.g. https://satyping-api.onrender.com
VITE_API_BASE_URL=http://localhost:4000
