##############################################################################
# SATyping — environment variables
#
# Copy this file to `.env` at the repo root (and/or per-package as needed)
# and fill in real values. Never commit the real `.env` file.
##############################################################################

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get this from your Neon project → Connection Details → "Pooled connection".
# Used by: lib/db (drizzle-kit push/migrate) and artifacts/api-server.
DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/dbname?sslmode=require

# ── API server (artifacts/api-server) ───────────────────────────────────────
NODE_ENV=development
PORT=4000
# Random long secret used to sign session cookies/tokens. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Comma-separated list of origins allowed to call the API (CORS).
# Local dev example: http://localhost:5173
# Production example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional: pino/console log verbosity (debug | info | warn | error)
LOG_LEVEL=info

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
# From your Razorpay Dashboard → Account & Settings → API Keys.
#
# Test vs live is decided ONLY by the key prefix — there is no separate sandbox URL:
#   rzp_test_...  → sandbox, no real money moves
#   rzp_live_...  → real charges
# Going to production is therefore just swapping these three values; no code change.
#
# NOTE: the variable is RAZORPAY_KEY_SECRET (not RAZORPAY_SECRET) — that is the name the
# server reads. The secret is shown only once when the key is generated.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
# From Dashboard → Settings → Webhooks, when you create the webhook pointing at
# POST /api/payments/webhook. Used to verify the x-razorpay-signature header.
#
# REQUIRED: if this is empty the webhook route throws on every call, so subscriptions would
# only ever activate via the browser-side POST /api/payments/verify fallback.
# For local testing the webhook cannot reach localhost at all — either expose the server with a
# tunnel (e.g. ngrok) and register that URL, or rely on the verify endpoint.
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# ── Email (verification / password reset) ───────────────────────────────────
# Optional — if any of these are unset, emails are logged instead of sent (safe for local dev).
#
# Test the configuration at any time with:
#   pnpm --filter @workspace/api-server run check-email you@example.com
#
# Free options:
#   Brevo  (300/day free) — SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
#          SMTP_USER/SMTP_PASS come from Brevo → SMTP & API → SMTP (use the SMTP KEY, not your
#          account password). Brevo can also restrict SMTP to an IP allowlist under
#          Security → Authorised IPs — an unlisted IP fails with "525 Unauthorized IP address"
#          even when the credentials are correct.
#   Gmail  — SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS = a 16-char App Password
#          (requires 2FA; a normal account password will NOT work).
#
# EMAIL_FROM must use a sender/domain the provider has VERIFIED, or sending is rejected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SATyping <no-reply@satyping.example>
# Used to build the links inside verification/reset emails — must point at the FRONTEND
# (Vercel URL in production), never the API server, or verification links will 404.
FRONTEND_URL=http://localhost:5000

# ── Frontend (artifacts/gcc-tbc) — must be prefixed VITE_ to be exposed ────
# Base URL of the deployed API server (Render), e.g. https://satyping-api.onrender.com
VITE_API_BASE_URL=http://localhost:4000
