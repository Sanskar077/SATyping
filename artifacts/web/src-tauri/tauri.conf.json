{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SATyping",
  "version": "0.1.0",
  "identifier": "com.satyping.app",
  "build": {
    "frontendDist": "https://sa-typing-api-project.vercel.app",
    "devUrl": "http://localhost:5000",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "windows": [
      {
        "title": "SATyping",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
